# Builds tippecanoe and tile-join for the PMTiles tasks. Debian trixie matches
# the ruby:4.0.5 base, so the binaries link against the same libraries.
FROM debian:trixie-slim AS tippecanoe
ARG TIPPECANOE_VERSION=2.79.0
RUN apt-get update -qq && apt-get install -y --no-install-recommends build-essential ca-certificates git libsqlite3-dev zlib1g-dev
RUN git clone --depth 1 --branch "${TIPPECANOE_VERSION}" https://github.com/felt/tippecanoe.git /src/tippecanoe \
  && make -C /src/tippecanoe -j"$(nproc)" \
  && make -C /src/tippecanoe install

# Use the Ruby 4.0.5 image from Docker Hub as the base image (https://hub.docker.com/_/ruby)
FROM ruby:4.0.5

RUN ls /etc
RUN apt update -qq && apt install -y postgresql-client git libvips curl cron vim libgeos-dev sqlite3

# Tile tools used by og_pmtiles:create: tippecanoe and tile-join from the stage
# above, and the pmtiles CLI from its GitHub release.
COPY --from=tippecanoe /usr/local/bin/tippecanoe /usr/local/bin/tile-join /usr/local/bin/
ARG PMTILES_VERSION=1.31.2
ARG TARGETARCH
RUN case "${TARGETARCH}" in arm64) arch=arm64 ;; *) arch=x86_64 ;; esac \
  && curl -fsSL "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${arch}.tar.gz" \
  | tar -xz -C /usr/local/bin pmtiles \
  && tippecanoe --version && command -v tile-join && pmtiles version && sqlite3 --version

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt install nodejs
RUN npm install --global yarn

WORKDIR /app

COPY . .

# Add Rails gems
RUN bundle install

ENV AUTHENTICATION_EXPIRATION=730
ENV GENERATE_SOURCEMAP=false
# config/environments/{production,staging}.rb gate ActionDispatch::Static
# (serving public/assets/*, manifest.json, etc. as real files) behind this
# var (`config.public_file_server.enabled = ENV["RAILS_SERVE_STATIC_FILES"].present?`).
# Never set anywhere in this deploy path before now - every static asset
# request fell through to the SPA catch-all route instead, served back as
# index.html regardless of the requested file (wrong MIME type on JS/CSS,
# invalid JSON on manifest.json - all from the same root cause). Always
# true for this container (nothing else serves these files - no separate
# nginx/CDN in front), so it's a constant here, not a per-deploy value.
ENV RAILS_SERVE_STATIC_FILES=true
ENV DISABLE_ESLINT_PLUGIN=true
ENV NODE_OPTIONS="--max-old-space-size=16384"
ENV RAILS_MAX_THREADS=5
ENV REACT_APP_IIIF_MANIFEST_ITEM_LIMIT=1000
ENV VITE_IIIF_MANIFEST_ITEM_LIMIT=1000

# Build and deploy React front-end
RUN yarn config set network-timeout 600000 -g
RUN yarn build && yarn deploy

# Clean up APT when done.
RUN apt clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create cron log file
RUN touch cron.log

RUN chmod +x ./ecds-entrypoint.sh

EXPOSE 3000 8108

ENTRYPOINT [ "./ecds-entrypoint.sh" ]